---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import {
  graph,
  organizationSchema,
  legalServiceSchema,
  websiteSchema,
  webPageSchema,
  breadcrumbSchema,
} from '../../lib/schema';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);

const path = '/makaleler/';
const jsonLd = graph([
  organizationSchema(),
  legalServiceSchema(),
  websiteSchema(),
  webPageSchema({
    path,
    name: 'Makaleler | Sümer Hukuk',
    description:
      'Gayrimenkul, tapu, ortaklığın giderilmesi ve miras kaynaklı taşınmaz konularında bilgilendirici makaleler.',
  }),
  breadcrumbSchema([
    { name: 'Ana Sayfa', path: '/' },
    { name: 'Makaleler', path },
  ]),
]);
---

<BaseLayout
  title="Makaleler | Gayrimenkul ve Tapu Hukuku"
  description="Tapu iptal, ortaklığın giderilmesi, muris muvazaası, ecrimisil ve gayrimenkul sözleşmeleri hakkında bilgilendirici makaleler."
  canonicalPath={path}
  jsonLd={jsonLd}
>
  <header class="page-hero">
    <div class="container">
      <Breadcrumb items={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Makaleler' }]} />
      <h1>Makaleler</h1>
      <p class="lead">
        Taşınmaz ve tapu hukukuna ilişkin genel bilgilendirme yazıları. Somut olayınız için ayrıca
        hukuki değerlendirme gerekir.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="grid-cards">
        {
          articles.map((article) => (
            <a class="topic-link" href={`/makaleler/${article.data.slug}/`}>
              <h2 style="font-size:1.1rem;">{article.data.title}</h2>
              <p>{article.data.description}</p>
              <p style="margin-top:0.75rem;color:var(--color-muted);font-size:0.9rem;">
                {article.data.category} ·
                {article.data.publishedDate.toLocaleDateString('tr-TR')}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
