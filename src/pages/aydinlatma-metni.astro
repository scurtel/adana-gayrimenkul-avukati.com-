---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../config/site';

const path = '/aydinlatma-metni/';
---

<BaseLayout
  title="Aydınlatma Metni"
  description="6698 sayılı KVKK kapsamında Sümer Hukuk bilgilendirme sitesi aydınlatma metni."
  canonicalPath={path}
>
  <header class="page-hero">
    <div class="container">
      <Breadcrumb items={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Aydınlatma Metni' }]} />
      <h1>Aydınlatma Metni</h1>
    </div>
  </header>
  <section class="section">
    <div class="container prose">
      <p>
        6698 sayılı Kişisel Verilerin Korunması Kanunu kapsamında, veri sorumlusu sıfatıyla
        {siteConfig.brandName}; iletişim talepleriniz çerçevesinde paylaştığınız kişisel verileri
        hukuki yükümlülüklerin yerine getirilmesi, iletişimin yürütülmesi ve meşru menfaatler
        doğrultusunda işleyebilir.
      </p>
      <h2>İşlenen veriler</h2>
      <p>
        Kimlik ve iletişim bilgileri (ad soyad, telefon, e-posta) ile mesaj içeriğinde yer alan
        bilgiler, form veya telefon/WhatsApp yoluyla iletildiğinde işlenebilir.
      </p>
      <h2>Aktarım</h2>
      <p>
        Verileriniz, yalnızca hizmetin gerektirdiği ölçüde ve kanuni zorunluluklar çerçevesinde
        yetkili kişi veya kurumlarla paylaşılabilir.
      </p>
      <h2>Haklarınız</h2>
      <p>
        KVKK’nın 11. maddesi kapsamındaki haklarınızı kullanmak için
        <a href="/iletisim/">iletişim kanallarımız</a>
        üzerinden başvurabilirsiniz.
      </p>
      <p>
        Adres: {siteConfig.fullAddress}<br />
        Telefon: <a href={siteConfig.telephoneHref}>{siteConfig.telephoneDisplay}</a>
      </p>
    </div>
  </section>
</BaseLayout>
