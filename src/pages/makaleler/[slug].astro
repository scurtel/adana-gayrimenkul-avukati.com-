---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { getTopicBySlug } from '../../data/navigation';
import { attorney } from '../../config/site';
import {
  graph,
  organizationSchema,
  legalServiceSchema,
  websiteSchema,
  webPageSchema,
  breadcrumbSchema,
  blogPostingSchema,
  personSchema,
} from '../../lib/schema';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/makaleler/${entry.data.slug}/`;
const published = entry.data.publishedDate.toISOString();
const updated = entry.data.updatedDate.toISOString();

const attribution = {
  author: entry.data.author || '',
  reviewedBy: entry.data.reviewedBy || '',
  authorUrl: entry.data.authorUrl || '',
  reviewerUrl: entry.data.reviewerUrl || '',
};

const includePerson =
  attribution.author === attorney.name || attribution.reviewedBy === attorney.name;

function linkLabel(href: string) {
  const slug = href.replace(/^\/|\/$/g, '').split('/').pop() || href;
  const topic = getTopicBySlug(slug);
  if (topic) return topic.title;
  if (href.includes('iletisim')) return 'İletişim';
  if (href.includes('makaleler')) return 'Makaleler';
  return href;
}

const jsonLd = graph([
  organizationSchema(),
  legalServiceSchema(),
  websiteSchema(),
  ...(includePerson ? [personSchema()] : []),
  webPageSchema({
    path,
    name: entry.data.title,
    description: entry.data.description,
  }),
  breadcrumbSchema([
    { name: 'Ana Sayfa', path: '/' },
    { name: 'Makaleler', path: '/makaleler/' },
    { name: entry.data.title, path },
  ]),
  blogPostingSchema({
    path,
    title: entry.data.title,
    description: entry.data.description,
    datePublished: published,
    dateModified: updated,
    attribution,
  }),
]);
---

<BaseLayout
  title={`${entry.data.title} | Sümer Hukuk`}
  description={entry.data.description}
  canonicalPath={path}
  ogType="article"
  jsonLd={jsonLd}
  publishedTime={published}
  modifiedTime={updated}
>
  <header class="page-hero">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Ana Sayfa', href: '/' },
          { label: 'Makaleler', href: '/makaleler/' },
          { label: entry.data.title },
        ]}
      />
      <h1>{entry.data.title}</h1>
      <p class="article-meta">
        {entry.data.category} ·
        <time datetime={published}>
          {entry.data.publishedDate.toLocaleDateString('tr-TR', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {
          attribution.reviewedBy === attorney.name && (
            <> · Hukuki inceleme: {attorney.name}</>
          )
        }
      </p>
      <p class="lead">{entry.data.description}</p>
    </div>
  </header>

  <section class="section">
    <div class="container prose">
      <Content />
      <AuthorCard
        author={attribution.author}
        reviewedBy={attribution.reviewedBy}
        authorUrl={attribution.authorUrl}
        reviewerUrl={attribution.reviewerUrl}
      />
      {
        entry.data.relatedPages?.length > 0 && (
          <aside>
            <h2>İlgili sayfalar</h2>
            <ul class="related-list">
              {entry.data.relatedPages.map((href) => (
                <li>
                  <a href={href}>{linkLabel(href)}</a>
                </li>
              ))}
              <li>
                <a href="/iletisim/">İletişim sayfasına gidin</a>
              </li>
            </ul>
          </aside>
        )
      }
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
