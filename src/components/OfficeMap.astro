---
import { lawFirm } from '../config/site';

const embedUrl = lawFirm.googleMapsEmbedUrl;
const mapsUrl = lawFirm.googleMapsUrl;
---

{
  embedUrl && (
    <section class="section office-map-section" aria-labelledby="office-map-heading">
      <div class="container">
        <div class="section-intro">
          <h2 id="office-map-heading">Ofis Konumu</h2>
          <p>Sümer Hukuk Bürosu’na ulaşım ve yol tarifi için haritayı kullanabilirsiniz.</p>
        </div>

        <div class="office-map-frame">
          <iframe
            src={embedUrl}
            title="Sümer Hukuk Bürosu Google Maps konumu"
            width="600"
            height="450"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
          />
        </div>

        {
          mapsUrl && (
            <div class="cta-actions office-map-cta">
              <a
                class="btn btn-primary"
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Google Maps’te Yol Tarifi Al
              </a>
            </div>
          )
        }
      </div>
    </section>
  )
}

<style>
  .office-map-frame {
    width: 100%;
    max-width: 100%;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
    background: var(--color-white);
  }

  .office-map-frame iframe {
    display: block;
    width: 100%;
    height: 440px;
    border: 0;
    max-width: 100%;
  }

  .office-map-cta {
    margin-top: var(--space-5);
  }

  @media (max-width: 960px) {
    .office-map-frame iframe {
      height: 380px;
    }
  }

  @media (max-width: 640px) {
    .office-map-frame iframe {
      height: 320px;
    }
  }
</style>
